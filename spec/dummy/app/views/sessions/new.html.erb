<div style="max-width: 360px; margin: 12vh auto; font-family: system-ui, sans-serif;">
  <h1 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.25rem;">Sign in to RivetCMS</h1>
  <p style="color: #666; font-size: 0.85rem; margin-bottom: 1.25rem;">
    Dummy-app login: any email works and creates the user.
  </p>

  <% if flash[:alert] %>
    <p style="color: #b91c1c; font-size: 0.85rem; margin-bottom: 0.75rem;"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: "/login", method: :post do |f| %>
    <%= f.email_field :email, placeholder: "you@example.com", autofocus: true,
          style: "width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #ccc; border-radius: 0.5rem; margin-bottom: 0.75rem; font-size: 0.9rem;" %>
    <%= f.submit "Sign in",
          style: "width: 100%; padding: 0.5rem; background: #4f39f6; color: white; border: none; border-radius: 0.5rem; font-size: 0.9rem; cursor: pointer;" %>
  <% end %>
</div>
