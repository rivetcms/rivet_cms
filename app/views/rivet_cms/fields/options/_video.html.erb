<%# Video field options: max size, allowed types %>
<div class="space-y-4">
  <div class="form-control">
    <%= f.label "options[max_size_mb]", "Maximum File Size (MB)", class: "label" %>
    <%= f.number_field "options[max_size_mb]",
                       value: @field.options&.dig("max_size_mb") || 100,
                       class: "input input-bordered w-full",
                       min: 1,
                       max: 1000 %>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Default: 100 MB</span>
    </label>
  </div>

  <div class="form-control">
    <%= f.label "options[allowed_types]", "Allowed Video Types", class: "label" %>
    <div class="flex flex-wrap gap-2">
      <% ["mp4", "webm", "mov", "avi"].each do |type| %>
        <label class="cursor-pointer">
          <input type="checkbox"
                 name="field[options][allowed_types][]"
                 value="<%= type %>"
                 <%= "checked" if @field.options&.dig("allowed_types")&.include?(type) || @field.options&.dig("allowed_types").nil? %>
                 class="peer hidden" />
          <span class="badge badge-lg peer-checked:badge-primary peer-checked:text-primary-content transition-colors cursor-pointer">
            .<%= type %>
          </span>
        </label>
      <% end %>
    </div>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Select allowed video formats</span>
    </label>
  </div>
</div>
