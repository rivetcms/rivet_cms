<%# Boolean field options: default value %>
<div class="space-y-4">
  <div class="form-control">
    <%= f.label "options[default]", "Default Value", class: "label" %>
    <div class="flex gap-4">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio"
               name="field[options][default]"
               value="false"
               <%= "checked" if @field.options&.dig("default") != "true" && @field.options&.dig("default") != true %>
               class="radio radio-primary" />
        <span>False (Off)</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio"
               name="field[options][default]"
               value="true"
               <%= "checked" if @field.options&.dig("default") == "true" || @field.options&.dig("default") == true %>
               class="radio radio-primary" />
        <span>True (On)</span>
      </label>
    </div>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Initial value when creating new content</span>
    </label>
  </div>
</div>
