<%# Markdown field options: preview toggle %>
<div class="space-y-4">
  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-4 p-4 bg-base-200/50 rounded-lg hover:bg-base-200 transition-colors">
      <input type="checkbox"
             name="field[options][preview]"
             value="true"
             <%= "checked" if @field.options&.dig("preview") == "true" || @field.options&.dig("preview") == true %>
             class="checkbox checkbox-primary" />
      <div>
        <span class="font-medium">Enable Live Preview</span>
        <p class="text-base-content/50 text-sm mt-0.5">Show rendered markdown alongside the editor</p>
      </div>
    </label>
  </div>

  <div class="form-control">
    <%= f.label "options[placeholder]", "Placeholder Text", class: "label" %>
    <%= f.text_field "options[placeholder]",
                     value: @field.options&.dig("placeholder"),
                     class: "input input-bordered w-full",
                     placeholder: "e.g., Write in markdown..." %>
  </div>
</div>
