<%# Integer field options: min, max, step %>
<div class="space-y-4">
  <div class="grid grid-cols-2 gap-4">
    <div class="form-control">
      <%= f.label "options[min]", "Minimum Value", class: "label" %>
      <%= f.number_field "options[min]",
                         value: @field.options&.dig("min"),
                         class: "input input-bordered w-full",
                         placeholder: "No minimum" %>
    </div>

    <div class="form-control">
      <%= f.label "options[max]", "Maximum Value", class: "label" %>
      <%= f.number_field "options[max]",
                         value: @field.options&.dig("max"),
                         class: "input input-bordered w-full",
                         placeholder: "No maximum" %>
    </div>
  </div>

  <div class="form-control">
    <%= f.label "options[step]", "Step Increment", class: "label" %>
    <%= f.number_field "options[step]",
                       value: @field.options&.dig("step") || 1,
                       class: "input input-bordered w-full",
                       min: 1 %>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Increment when using arrows (default: 1)</span>
    </label>
  </div>

  <div class="form-control">
    <%= f.label "options[default]", "Default Value", class: "label" %>
    <%= f.number_field "options[default]",
                       value: @field.options&.dig("default"),
                       class: "input input-bordered w-full",
                       placeholder: "No default" %>
  </div>
</div>
