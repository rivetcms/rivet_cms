<%# File field options: max size, allowed types %>
<div class="space-y-4">
  <div class="form-control">
    <%= f.label "options[max_size_mb]", "Maximum File Size (MB)", class: "label" %>
    <%= f.number_field "options[max_size_mb]",
                       value: @field.options&.dig("max_size_mb") || 50,
                       class: "input input-bordered w-full",
                       min: 1,
                       max: 500 %>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Default: 50 MB</span>
    </label>
  </div>

  <div class="form-control">
    <%= f.label "options[allowed_types]", "Allowed File Extensions", class: "label" %>
    <%= f.text_field "options[allowed_types]",
                     value: @field.options&.dig("allowed_types")&.join(", "),
                     class: "input input-bordered w-full",
                     placeholder: "e.g., pdf, doc, docx, xls, xlsx" %>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Comma-separated list of extensions (leave empty to allow all)</span>
    </label>
  </div>
</div>
