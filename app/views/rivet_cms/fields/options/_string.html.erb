<%# String field options: max_length, placeholder %>
<div class="space-y-4">
  <div class="form-control">
    <%= f.label "options[max_length]", "Maximum Length", class: "label" %>
    <%= f.number_field "options[max_length]",
                       value: @field.options&.dig("max_length"),
                       class: "input input-bordered w-full",
                       min: 1,
                       placeholder: "No limit" %>
    <label class="label">
      <span class="label-text-alt text-base-content/50">Leave empty for no limit</span>
    </label>
  </div>

  <div class="form-control">
    <%= f.label "options[placeholder]", "Placeholder Text", class: "label" %>
    <%= f.text_field "options[placeholder]",
                     value: @field.options&.dig("placeholder"),
                     class: "input input-bordered w-full",
                     placeholder: "e.g., Enter a title..." %>
  </div>
</div>
