<%# Slide-over drawer for field editing %>
<div class="drawer drawer-end">
  <input id="field-drawer-toggle" type="checkbox" class="drawer-toggle" data-field-drawer-target="drawer" />

  <div class="drawer-side z-50">
    <label for="field-drawer-toggle" aria-label="close sidebar" class="drawer-overlay" data-action="click->field-drawer#closeOnOverlay"></label>

    <div class="bg-base-100 min-h-full w-full sm:w-[420px] flex flex-col shadow-2xl">
      <!-- Header -->
      <div class="flex items-center justify-between p-5 border-b border-base-200">
        <h3 class="text-lg font-semibold" data-field-drawer-target="title">Field</h3>
        <button type="button"
                class="btn btn-ghost btn-sm btn-square"
                data-action="click->field-drawer#close"
                aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto p-5" data-field-drawer-target="content">
        <div class="flex items-center justify-center h-32">
          <span class="loading loading-spinner loading-md text-base-content/30"></span>
        </div>
      </div>
    </div>
  </div>
</div>
