<%= render 'layouts/rivet_cms/notice', notice: notice if notice %>
<div class="max-w-2xl mx-auto">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h2 class="card-title">Edit Component</h2>
      <p class="text-base-content/70">Update the component details below.</p>
      <div class="divider"></div>
      <%= render "form" %>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to "Back To Components", components_path, class: "btn btn-outline" %>
  </div>
</div>
