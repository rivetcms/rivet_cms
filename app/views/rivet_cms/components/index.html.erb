<%= render 'layouts/rivet_cms/notice', notice: notice if notice %>
<div class="flex justify-between items-center mb-8">
  <h1 class="text-xl font-semibold">Components</h1>
  <%= link_to "New Component", new_component_path, class: "btn btn-primary", data: { turbo_frame: "main_content", turbo_action: "advance" } %>
</div>

<div class="overflow-x-auto" id="content-types">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Slug</th>
        <th>Category</th>
        <th>Repeatable</th>
        <th class="bg-base-100 sticky right-0">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @components.each do |component| %>
        <tr class="hover">
          <td><%= component.name %></td>
          <td><%= component.slug %></td>
          <td>
            <span class="badge badge-ghost"><%= component.category.name %></span>
          </td>
          <td>
            <span class="badge <%= component.repeatable ? 'badge-success' : 'badge-neutral' %>">
              <%= component.repeatable ? "Yes" : "No" %>
            </span>
          </td>
          <td class="bg-base-100 sticky right-0">
            <div class="flex gap-1">
              <%= link_to component, class: "btn btn-ghost btn-sm btn-square", data: { turbo_action: "advance" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              <% end %>
              <%= link_to edit_component_path(component), class: "btn btn-ghost btn-sm btn-square", data: { turbo_action: "advance" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
                </svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @components.empty? %>
  <%= render "rivet_cms/shared/empty", resource_name: "Components", new_path: new_component_path %>
<% end %>
