<%= render 'layouts/rivet_cms/notice', notice: notice if notice %>
<div class="max-w-2xl mx-auto">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h2 class="card-title">New Content Type</h2>
      <p class="text-base-content/70">Fill in the form below to create a new content type.</p>
      <div class="divider"></div>
      <%= render "form" %>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to "Back To Content Types", content_types_path, class: "btn btn-outline", data: { turbo_action: "advance" } %>
  </div>
</div>
