<%= render "layouts/rivet_cms/notice" %>

<div class="max-w-2xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight mb-1">Edit Content Type</h1>
    <p class="text-base-content/50">Update the settings for "<%= @content_type.name %>"</p>
  </div>

  <!-- Form Card -->
  <div class="bg-base-100 border border-base-300 rounded-xl">
    <div class="p-6">
      <%= render "form" %>
    </div>
  </div>

  <!-- Danger Zone -->
  <div class="mt-8 bg-error/5 border border-error/20 rounded-xl p-6">
    <div class="flex items-start gap-4">
      <div class="shrink-0 w-10 h-10 rounded-lg bg-error/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-error">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="font-semibold text-error mb-1">Delete Content Type</h3>
        <p class="text-sm text-base-content/60 mb-4">
          Permanently delete this content type and all its fields. This action cannot be undone.
        </p>
        <%= button_to content_type_path(@content_type),
                      method: :delete,
                      class: "btn btn-error btn-sm",
                      data: { turbo_confirm: "Delete \"#{@content_type.name}\" and all its fields? This cannot be undone." } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          Delete Content Type
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-8">
  <%= link_to content_type_path(@content_type), class: "btn btn-ghost btn-sm gap-2", data: { turbo_frame: "main_content" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    Back to Content Type
  <% end %>
</div>
