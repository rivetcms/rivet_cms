<%= form_with model: @content_type, class: "space-y-6", data: { controller: "content-type-form" } do |f| %>
  <div class="form-control w-full">
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input input-bordered w-full", required: true, data: { content_type_form_target: "name" } %>
  </div>
  <div class="form-control w-full">
    <%= f.label :slug, class: "label" %>
    <%= f.text_field :slug, class: "input input-bordered w-full", required: true, data: { content_type_form_target: "slug" } %>
  </div>
  <div class="form-control w-full">
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description, class: "textarea textarea-bordered w-full", rows: 3 %>
  </div>
  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-4">
      <%= f.check_box :single, class: "checkbox checkbox-primary", data: { content_type_form_target: "single" } %>
      <span class="label-text">Single Entry</span>
    </label>
    <p class="text-base-content/60 text-sm ml-10">
      If checked, this will be a single type (one entry). If unchecked, it will be a collection type (multiple entries).
    </p>
  </div>
  <div class="flex justify-end gap-3 pt-6">
    <%= link_to "Cancel", content_types_path, class: "btn btn-outline" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
