{
  "name": "rivet_cms",
  "private": true,
  "dependencies": {
    "@inertiajs/react": "^2.0.0",
    "axios": "^1.7.0",
    "daisyui": "^5.5.14",
    "pluralize": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "esbuild": "^0.27.0"
  },
  "scripts": {
    "build": "esbuild app/javascript/rivet_cms.jsx --bundle --minify --sourcemap --format=esm --jsx=automatic --outdir=app/assets/builds --public-path=/assets",
    "build:css": "npx @tailwindcss/cli -i ./app/assets/stylesheets/rivet_cms/application.tailwind.css -o ./app/assets/builds/rivet_cms.css --minify"
  }
}
